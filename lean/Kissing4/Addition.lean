/-- **The addition theorem for `k ≤ 7`.** -/
theorem Zt_addition {k : ℕ} (hk : k ≤ 7) (a b c a' b' c' : ℝ) :
    Zt a b c a' b' c' k = ∑ m ∈ Finset.range (k + 1),
      coefK k m * Aa k m a b c * Aa k m a' b' c' * Rc a b a' b' m := by
  interval_cases k
  · exact Zt_addition_0 a b c a' b' c'
  · exact Zt_addition_1 a b c a' b' c'
  · exact Zt_addition_2 a b c a' b' c'
  · exact Zt_addition_3 a b c a' b' c'
  · exact Zt_addition_4 a b c a' b' c'
  · exact Zt_addition_5 a b c a' b' c'
  · exact Zt_addition_6 a b c a' b' c'
  · exact Zt_addition_7 a b c a' b' c'

end Kissing4

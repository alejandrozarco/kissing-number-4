theorem Zt_addition_4 (a b c a' b' c' : ℝ) :
    Zt a b c a' b' c' 4 = ∑ m ∈ Finset.range 5,
      coefK 4 m * Aa 4 m a b c * Aa 4 m a' b' c' * Rc a b a' b' m := by
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, Zt, Rc, Aa, coefK]

theorem Zt_addition_6 (a b c a' b' c' : ℝ) :
    Zt a b c a' b' c' 6 = ∑ m ∈ Finset.range 7,
      coefK 6 m * Aa 6 m a b c * Aa 6 m a' b' c' * Rc a b a' b' m := by

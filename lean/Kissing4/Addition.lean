theorem Zt_addition_7 (a b c a' b' c' : ℝ) :
    Zt a b c a' b' c' 7 = ∑ m ∈ Finset.range 8,
      coefK 7 m * Aa 7 m a b c * Aa 7 m a' b' c' * Rc a b a' b' m := by
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, Zt, Rc, Aa, coefK]
  push_cast
